{
  "app": {
    "host": "127.0.0.1",
    "port": 8080,
    "data_dir": "../data",
    "simulation": false,
    "open_browser": true,
    "allow_remote_control": false
  },
  "camera": {
    "device": "/dev/v4l/by-id/REPLACE_WITH_C920_SYMLINK",
    "width": 1920,
    "height": 1080,
    "fps": 15,
    "fourcc": "MJPG",
    "autostart": true,
    "controls": {
      "focus_automatic_continuous": 0,
      "focus_auto": 0,
      "focus_absolute": 40,
      "exposure_auto": 1,
      "exposure_time_absolute": 250,
      "white_balance_automatic": 0,
      "white_balance_temperature": 4500,
      "gain": 0
    }
  },
  "machine": {
    "backend": "serial",
    "protocol": "auto",
    "port": "/dev/serial/by-id/REPLACE_WITH_CONTROLLER_SYMLINK",
    "baudrate": 115200,
    "read_timeout": 3.0,
    "work_area": {
      "x_min": 0.0,
      "x_max": 220.0,
      "y_min": 0.0,
      "y_max": 220.0
    },
    "photo_position": {
      "x": 110.0,
      "y": 110.0,
      "z": null
    },
    "home_before_photo": true,
    "allow_motion": false,
    "controller_startup_delay": 2.0
  },
  "laser": {
    "power_mode": "M4",
    "power_max": 1000,
    "default_power": 0,
    "frame_power": 0,
    "travel_feed_mm_min": 2000.0,
    "engrave_feed_mm_min": 1000.0,
    "boundary_margin_mm": 5.0,
    "arm_timeout_seconds": 45,
    "allow_low_power_frame": false,
    "return_to_photo_position": false
  }
}
